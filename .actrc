# act local runner config (ezk-ci). Prouve la CI en local avant de pousser :
#   act -l                          # liste les jobs
#   act --dryrun                    # parse sans exécuter (rapide, sûr)
#   act pull_request -j ci          # rejoue le job ci en local
# Pré-requis : Docker Desktop lancé.

# Apple Silicon : les runners GitHub sont linux/amd64 (sinon "exec format error").
--container-architecture linux/amd64

# Images runner pinnées (medium : Node + outils courants pré-installés).
-P ubuntu-latest=catthehacker/ubuntu:act-22.04
-P ubuntu-22.04=catthehacker/ubuntu:act-22.04
-P ubuntu-24.04=catthehacker/ubuntu:act-24.04

# Réutilise le container entre runs (cache apt/pnpm) : run 60s -> 10s.
# Reset : docker rm -f $(docker ps -aq -f name=act-)
--reuse
