#!/usr/bin/env bash
# ezk-secret-check <service> — vérifie un secret SANS le révéler.
#
# Affiche trois choses, jamais la valeur en clair :
#   - longueur (a-t-il été tronqué au collage ?) ;
#   - aperçu masqué « 2 premiers … 2 derniers » — UNIQUEMENT si ≥ 12 caractères
#     (en dessous, on révélerait presque tout un secret court) ;
#   - empreinte = SHA-256 tronquée (aucun caractère en clair ; confirme « c'est
#     bien la même clé » entre deux machines / deux dépôts).
#
# La lecture PEUT déclencher une validation selon la config du trousseau (voir
# README, §Authentification — le CLI natif ne protège en général PAS la lecture).
set -euo pipefail

SERVICE="${1:-}"
[ -n "$SERVICE" ] || { echo "usage: ezk-secret-check <service>" >&2; exit 1; }

VALUE="$(security find-generic-password -s "$SERVICE" -w 2>/dev/null)" \
  || { echo "introuvable dans le trousseau : « $SERVICE »" >&2; exit 1; }

LEN=${#VALUE}
FP="$(printf %s "$VALUE" | shasum -a 256 | cut -c1-12)"
if [ "$LEN" -ge 12 ]; then
  PREVIEW="${VALUE:0:2}…${VALUE: -2}"
else
  PREVIEW="(trop court pour un aperçu sûr)"
fi
unset VALUE

printf '%s : longueur=%d  aperçu=%s  empreinte=%s\n' "$SERVICE" "$LEN" "$PREVIEW" "$FP"
