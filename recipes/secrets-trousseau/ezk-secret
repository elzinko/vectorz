#!/usr/bin/env bash
# ezk-secret <verbe> [args] — CLI unique pour ranger des secrets dans le trousseau macOS.
#
# Remplace les 5 scripts ezk-secret-* (set, set-ionos, get, list, check) par un seul
# dispatcher aux conventions POSIX : le NOM du secret est un argument positionnel, les
# options sont des drapeaux, et `--help` marche partout.
#
# Sécurité (inchangée) : les secrets sont des « generic passwords » du trousseau login,
# stockés par défaut avec `-T ''` → aucune app pré-autorisée → macOS confirme chaque
# lecture (« accès sur demande »). `--trust <app>` pré-autorise un binaire, en opt-in
# explicite et avec avertissement (ça affaiblit le modèle).
set -euo pipefail

PROG="ezk-secret"

# die : erreur d'USAGE (mauvais verbe/option, argument requis manquant) → code 2.
die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 2; }
# fail : erreur d'EXÉCUTION (dépendance absente, secret introuvable, valeur vide) → code 1.
fail() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
$PROG <verbe> [args] — gère des secrets dans le trousseau macOS (accès sur demande).

Verbes :
  set <nom> [--clip] [--trust <app>]   crée ou remplace un secret (upsert)
  get <nom>                            révèle le secret sur stdout (à CAPTURER, jamais afficher)
  check <nom>                          inspecte sans révéler (longueur, aperçu masqué, empreinte)
  list [motif]                         liste les noms rangés (jamais les valeurs)
  remove <nom>                         supprime un secret
  open [nom]                           ouvre le Trousseau d'accès
  help | --help | -h                   affiche cette aide

Exemples :
  $PROG set samplerz-ionos-api --clip     # coller « préfixe.secret » au préalable
  KEY=\$($PROG get samplerz-ionos-api)
  $PROG check samplerz-ionos-api
  $PROG list samplerz

Détail d'un verbe : $PROG <verbe> --help
EOF
}

help_set() {
  cat <<EOF
$PROG set <nom> [--clip] [--trust <app>]
  Crée ou remplace (upsert) le secret « <nom> ».
  Défaut : saisie MASQUÉE au terminal (jamais en argument, jamais dans l'historique).
  --clip          lit la valeur depuis le presse-papier (pbpaste) — pour les clés LONGUES
                  que la saisie masquée tronque (JWT, clés Lemon Squeezy…).
  --trust <app>   pré-autorise <app> à lire ce secret (⚠ affaiblit « valider chaque
                  accès » — opt-in explicite ; défaut : confirmation à chaque lecture).
  Cas IONOS (« préfixe.secret ») : colle la valeur COMPLÈTE et fais « set --clip ».
EOF
}
help_get() {
  cat <<EOF
$PROG get <nom>
  Écrit le secret sur stdout. ⚠ À CAPTURER dans une variable, JAMAIS à afficher :
    KEY=\$($PROG get samplerz-ionos-api)
EOF
}
help_check() {
  cat <<EOF
$PROG check <nom>
  Inspecte le secret SANS le révéler : longueur, aperçu masqué (2 premiers … 2 derniers,
  si ≥ 12 caractères) et empreinte SHA-256 tronquée (confirme « même clé » entre machines).
EOF
}
help_list() {
  cat <<EOF
$PROG list [motif]
  Liste les NOMS des secrets rangés (jamais les valeurs). Avec [motif] : filtre (grep -i).
EOF
}
help_remove() {
  cat <<EOF
$PROG remove <nom>
  Supprime le secret « <nom> » du trousseau.
EOF
}
help_open() {
  cat <<EOF
$PROG open [nom]
  Ouvre l'app « Trousseau d'accès » (les secrets ezk n'apparaissent PAS dans l'app
  « Mots de passe », qui ne gère que les logins iCloud et passkeys). [nom] est réservé.
EOF
}

cmd_set() {
  local clip=0 trust='' name=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h) help_set; return 0 ;;
      --clip)    clip=1; shift ;;
      --trust)   trust="${2:-}"; [ -n "$trust" ] || die "set : --trust exige le nom d'une app"; shift 2 ;;
      --)        shift; break ;;
      -*)        die "set : option inconnue « $1 »" ;;
      *)         if [ -z "$name" ]; then name="$1"; shift; else die "set : argument en trop « $1 »"; fi ;;
    esac
  done
  [ -n "$name" ] || die "usage : $PROG set <nom> [--clip] [--trust <app>]"

  local value
  if [ "$clip" -eq 1 ]; then
    command -v pbpaste >/dev/null 2>&1 || fail "pbpaste introuvable (macOS requis)."
    # $(...) retire un éventuel retour à la ligne final du presse-papier.
    value="$(pbpaste)"
    [ -n "$value" ] || fail "presse-papier vide — abandon."
    printf '→ depuis le presse-papier (%d caractères).\n' "${#value}" >&2
  else
    printf 'Valeur secrète pour « %s » (saisie masquée, Entrée pour valider) : ' "$name" >&2
    IFS= read -rs value < /dev/tty
    printf '\n' >&2
    [ -n "$value" ] || fail "valeur vide — abandon."
  fi

  # -U : upsert (crée ou remplace). Par défaut -T '' (aucune app de confiance).
  local -a trust_args=(-T '')
  if [ -n "$trust" ]; then
    trust_args=(-T "$trust")
    printf '⚠ --trust « %s » : pré-autorise ce binaire → affaiblit « valider chaque accès ».\n' "$trust" >&2
  fi
  security add-generic-password -a "$USER" -s "$name" -w "$value" "${trust_args[@]}" -U
  unset value
  printf '✓ « %s » rangé. Vérifie sans le révéler : %s check %s\n' "$name" "$PROG" "$name" >&2
}

cmd_get() {
  case "${1:-}" in --help|-h) help_get; return 0 ;; esac
  local name="${1:-}"
  [ -n "$name" ] || die "usage : $PROG get <nom>"
  shift
  [ "$#" -eq 0 ] || die "get : argument en trop « $1 » (un seul nom attendu)"
  security find-generic-password -s "$name" -w
}

cmd_check() {
  case "${1:-}" in --help|-h) help_check; return 0 ;; esac
  local name="${1:-}"
  [ -n "$name" ] || die "usage : $PROG check <nom>"
  shift
  [ "$#" -eq 0 ] || die "check : argument en trop « $1 » (un seul nom attendu)"
  local value
  value="$(security find-generic-password -s "$name" -w 2>/dev/null)" \
    || fail "introuvable dans le trousseau : « $name »"
  local len=${#value} preview fp
  fp="$(printf %s "$value" | shasum -a 256 | cut -c1-12)"
  if [ "$len" -ge 12 ]; then
    preview="${value:0:2}…${value: -2}"
  else
    preview="(trop court pour un aperçu sûr)"
  fi
  unset value
  printf '%s : longueur=%d  aperçu=%s  empreinte=%s\n' "$name" "$len" "$preview" "$fp"
}

cmd_list() {
  case "${1:-}" in --help|-h) help_list; return 0 ;; esac
  [ "$#" -le 1 ] || die "list : argument en trop « $2 » (un seul motif attendu)"
  local pattern="${1:-}"
  # `dump-keychain` (sans -d) ne révèle AUCUNE valeur ; on n'en extrait que les noms (svce).
  security dump-keychain 2>/dev/null \
    | sed -n 's/^ *"svce"<blob>="\(.*\)"$/\1/p' \
    | sort -u \
    | if [ -n "$pattern" ]; then grep -i -- "$pattern" || true; else cat; fi
}

cmd_remove() {
  case "${1:-}" in --help|-h) help_remove; return 0 ;; esac
  local name="${1:-}"
  [ -n "$name" ] || die "usage : $PROG remove <nom>"
  shift
  [ "$#" -eq 0 ] || die "remove : argument en trop « $1 » (un seul nom attendu)"
  security delete-generic-password -s "$name" >/dev/null 2>&1 \
    || fail "introuvable dans le trousseau : « $name »"
  printf '✓ « %s » supprimé.\n' "$name" >&2
}

cmd_open() {
  case "${1:-}" in --help|-h) help_open; return 0 ;; esac
  [ "$#" -le 1 ] || die "open : argument en trop « $2 »"
  # Le Trousseau d'accès ne se cible pas par nom via `open` : [nom] est accepté mais réservé.
  open -a "Keychain Access"
}

main() {
  local verb="${1:-}"
  if [ $# -gt 0 ]; then shift; fi
  case "$verb" in
    set)            cmd_set "$@" ;;
    get)            cmd_get "$@" ;;
    check)          cmd_check "$@" ;;
    list)           cmd_list "$@" ;;
    remove)         cmd_remove "$@" ;;
    open)           cmd_open "$@" ;;
    help|--help|-h) usage ;;
    '')             usage >&2; exit 2 ;;
    *)              printf '%s: verbe inconnu « %s »\n\n' "$PROG" "$verb" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
