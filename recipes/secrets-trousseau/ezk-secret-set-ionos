#!/usr/bin/env bash
# ezk-secret-set-ionos [service] — range la clé API IONOS au format « préfixe.secret ».
# Demande les DEUX valeurs séparément et pose le point tout seul (évite l'oubli).
set -euo pipefail
SERVICE="${1:-samplerz-ionos-api}"

printf 'Préfixe public IONOS (visible) : ' >&2
IFS= read -r PREFIX < /dev/tty
printf 'Secret IONOS (masqué)          : ' >&2
IFS= read -rs SECRET < /dev/tty
printf '\n' >&2

# retire d'éventuels caractères parasites collés (espaces, invisibles)
PREFIX=$(printf '%s' "$PREFIX" | LC_ALL=C tr -cd '0-9a-zA-Z._-')
SECRET=$(printf '%s' "$SECRET" | LC_ALL=C tr -cd '0-9a-zA-Z._-')
[ -n "$PREFIX" ] && [ -n "$SECRET" ] || { echo "❌ préfixe ou secret vide — abandon." >&2; exit 1; }

security add-generic-password -a "$USER" -s "$SERVICE" -w "${PREFIX}.${SECRET}" -T '' -U
echo "✓ « $SERVICE » rangé (préfixe=${#PREFIX} car., secret=${#SECRET} car., + le point)." >&2
unset PREFIX SECRET
