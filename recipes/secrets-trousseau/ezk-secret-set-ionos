#!/usr/bin/env bash
# DÉPRÉCIÉ — le cas IONOS n'a plus de script dédié (fiche 20260906121839943).
# La clé IONOS a la forme « préfixe.secret » ; le préfixe est un identifiant PUBLIC, donc
# rien ne justifie une saisie spéciale. On colle la valeur COMPLÈTE en une fois :
#     ezk-secret set <nom> --clip
# Ce shim reste le temps de la transition, puis sera retiré.
DIR="$(cd "$(dirname "$0")" && pwd)"
printf '⚠ « ezk-secret-set-ionos » est déprécié. Le cas IONOS se fait désormais via :\n' >&2
printf '    ezk-secret set <nom> --clip   (colle la valeur complète « préfixe.secret »)\n' >&2
printf 'Redirection vers « ezk-secret set »…\n' >&2
exec "$DIR/ezk-secret" set "$@"
