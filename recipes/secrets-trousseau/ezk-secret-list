#!/usr/bin/env bash
# ezk-secret-list [motif] — liste les NOMS des secrets rangés (jamais les valeurs).
#
# Ex. : ezk-secret-list samplerz   → tous les secrets du projet samplerz.
# Sans motif : tous les noms. `security dump-keychain` (sans -d) ne révèle AUCUNE valeur.
set -euo pipefail

PATTERN="${1:-}"
security dump-keychain 2>/dev/null \
  | sed -n 's/^ *"svce"<blob>="\(.*\)"$/\1/p' \
  | sort -u \
  | if [ -n "$PATTERN" ]; then grep -i -- "$PATTERN" || true; else cat; fi
