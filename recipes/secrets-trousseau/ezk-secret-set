#!/usr/bin/env bash
# ezk-secret-set [--clip] <service> — range un secret dans le trousseau macOS.
#
# Par défaut : saisie MASQUÉE dans le terminal (jamais en argument → jamais dans
# l'historique du shell). Stocké avec `-T ''` (aucune app pré-autorisée — voir
# README, §Authentification : le comportement dépend de la version de macOS).
#
# --clip : lit la valeur depuis le PRESSE-PAPIER (`pbpaste`). À utiliser pour les
# clés LONGUES (JWT Lemon Squeezy…) : la saisie masquée passe par une ligne de
# terminal, qui TRONQUE au-delà d'une longueur (mode canonique) et peut capturer
# un caractère invisible du collage → clé corrompue. `--clip` contourne ça.
# ⚠️ Compromis : en `--clip`, la valeur transite une fraction de seconde comme
# argument de `security` (visible à `ps` sur TA machine). Acceptable en local ;
# préfère la saisie masquée pour les secrets courts.
set -euo pipefail

CLIP=0
if [ "${1:-}" = "--clip" ]; then CLIP=1; shift; fi

SERVICE="${1:-}"
[ -n "$SERVICE" ] || { echo "usage: ezk-secret-set [--clip] <service>" >&2; exit 1; }

if [ "$CLIP" -eq 1 ]; then
  command -v pbpaste >/dev/null 2>&1 || { echo "pbpaste introuvable (macOS requis)." >&2; exit 1; }
  # $(...) enlève un éventuel retour à la ligne final du presse-papier.
  VALUE="$(pbpaste)"
  [ -n "$VALUE" ] || { echo "Presse-papier vide — abandon." >&2; exit 1; }
  echo "→ depuis le presse-papier (${#VALUE} caractères)." >&2
else
  printf 'Valeur secrète pour « %s » (saisie masquée, Entrée pour valider) : ' "$SERVICE" >&2
  IFS= read -rs VALUE < /dev/tty
  printf '\n' >&2
  [ -n "$VALUE" ] || { echo "Vide — abandon." >&2; exit 1; }
fi

# -U : met à jour l'entrée si elle existe déjà ; -T '' : aucune app de confiance.
security add-generic-password -a "$USER" -s "$SERVICE" -w "$VALUE" -T '' -U
unset VALUE

echo "✓ « $SERVICE » rangé. Vérifie sans le révéler : ezk-secret-check $SERVICE" >&2
