#!/usr/bin/env bash
# ezk-secret-set <service> — range un secret dans le trousseau macOS.
#
# Le secret est saisi MASQUÉ dans le terminal (jamais passé en argument → jamais dans
# l'historique du shell) puis stocké chiffré. Il est rangé avec `-T ''` : aucune
# application n'est pré-autorisée, pour que chaque lecture demande une validation
# (voir README, §Authentification — comportement à vérifier selon la version de macOS).
set -euo pipefail

SERVICE="${1:-}"
[ -n "$SERVICE" ] || { echo "usage: ezk-secret-set <service>" >&2; exit 1; }

printf 'Valeur secrète pour « %s » (saisie masquée, Entrée pour valider) : ' "$SERVICE" >&2
IFS= read -rs VALUE < /dev/tty
printf '\n' >&2
[ -n "$VALUE" ] || { echo "Vide — abandon." >&2; exit 1; }

# -U : met à jour l'entrée si elle existe déjà ; -T '' : aucune app de confiance.
security add-generic-password -a "$USER" -s "$SERVICE" -w "$VALUE" -T '' -U
unset VALUE

echo "✓ « $SERVICE » rangé dans le trousseau (lecture protégée)." >&2
