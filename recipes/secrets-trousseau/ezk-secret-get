#!/usr/bin/env bash
# ezk-secret-get <service> — lit un secret du trousseau, sur stdout.
#
# ⚠️ À CAPTURER dans une variable, JAMAIS à afficher :
#     KEY=$(ezk-secret-get samplerz-ionos-api)
#
# Selon la config du trousseau, la lecture peut déclencher une validation (Touch ID /
# mot de passe de session). Si la sortie est une longue chaîne HEXADÉCIMALE, un caractère
# parasite s'est glissé au stockage → refais `ezk-secret-set` proprement (voir README).
set -euo pipefail

SERVICE="${1:-}"
[ -n "$SERVICE" ] || { echo "usage: ezk-secret-get <service>" >&2; exit 1; }

security find-generic-password -s "$SERVICE" -w
