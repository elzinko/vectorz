{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "description": "Hérité : fiches par statut écrit, brut, sans interprétation. Pour afficher, lire comptes."
    },
    "tirables": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "milestone": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "pr": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked": {
            "type": "string",
            "description": "Raison du blocage (`blocked:`), '' si la fiche n'est pas bloquée."
          },
          "blockedLibelle": {
            "type": "string",
            "description": "La raison du blocage en français : la décision attendue, même table que `ezk now --json` ; '' sans blocage."
          },
          "version": {
            "type": "string",
            "description": "Version ciblée telle qu'écrite, '' sans version."
          },
          "enCours": {
            "type": "boolean",
            "description": "Une branche de travail est ouverte pour la fiche (ADR-0077)."
          },
          "file": {
            "type": "string",
            "description": "Chemin de la fiche, relatif à la racine du projet."
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "priority",
          "status",
          "milestone",
          "product",
          "pr",
          "labels",
          "blocked",
          "blockedLibelle",
          "version",
          "enCours",
          "file"
        ]
      },
      "description": "Fiches à faire, hors parkées, triées priorité puis id."
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "milestone": {
            "type": "string"
          },
          "nom": {
            "type": "string",
            "description": "Nom en clair, lu dans la déclaration `features/milestones/<slug>.md` ; '' sans déclaration. Jamais lu dans PLAN.md."
          },
          "status": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "shipped": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids des fiches actives (hors done/) de l’objectif, triés."
          },
          "livrees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids des fiches livrées (rangées dans done/) de l’objectif, triés : autant que shipped."
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Versions distinctes et non vides de ces livrées, dans l’ordre des versions."
          }
        },
        "required": [
          "milestone",
          "nom",
          "status",
          "total",
          "shipped",
          "counts",
          "children",
          "livrees",
          "versions"
        ]
      }
    },
    "filtres": {
      "type": "object",
      "properties": {
        "statuts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priorites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "produits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "statuts",
        "priorites",
        "produits",
        "labels",
        "milestones"
      ]
    },
    "comptes": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Toutes les fiches du projet."
        },
        "idees": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Idées, hors parkées et hors en cours."
        },
        "pretes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Prêtes sans branche ouverte : le stock tirable."
        },
        "enCours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Fiches avec une branche de travail ouverte (ADR-0077)."
        },
        "parkees": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Idées rangées dans la milestone `parked`."
        },
        "livrees": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Statut `shipped`."
        },
        "closes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Closes sans livraison : superseded, merged, split."
        },
        "autres": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Statut inconnu de la méthode (le validateur le signale)."
        },
        "bloquees": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Drapeau : fiches à faire (idées, prêtes, en cours, autres) qui portent `blocked:`. Recoupe les colonnes."
        },
        "sansVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Drapeau : fiches à faire sans version, hors parkées. Recoupe les colonnes."
        }
      },
      "required": [
        "total",
        "idees",
        "pretes",
        "enCours",
        "parkees",
        "livrees",
        "closes",
        "autres",
        "bloquees",
        "sansVersion"
      ],
      "description": "Comptes interprétés par les règles de la méthode. Les colonnes de idees à autres se partagent les fiches : leur somme vaut total."
    },
    "versions": {
      "type": "object",
      "properties": {
        "courante": {
          "description": "La version en cours : le premier lot sans étiquette (ADR-0070).",
          "type": [
            "string",
            "null"
          ]
        },
        "ecartees": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Versions après la version en cours, écartées du tirage."
        },
        "lots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              },
              "nom": {
                "type": "string",
                "description": "Nom en clair, lu dans la déclaration `features/versions/<vX.Y.Z>.md` (ADR-0088 §7) ; '' sans déclaration. Jamais lu dans PLAN.md."
              },
              "milestones": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Objectifs distincts et non vides des fiches du lot (livrées et à faire), triés."
              },
              "etat": {
                "type": "string",
                "enum": [
                  "en-cours",
                  "a-clore",
                  "livree",
                  "rouverte",
                  "vide"
                ]
              },
              "cycleDeVie": {
                "type": "string",
                "enum": [
                  "brouillon",
                  "figee",
                  "livree"
                ]
              },
              "etiquette": {
                "description": "Étiquette git de release (`v1.2.0`), null si la version n’est pas sortie.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "dateEtiquette": {
                "description": "Date ISO 8601 de l’étiquette de release (`git for-each-ref`), null sans étiquette.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "etiquetteGel": {
                "description": "Étiquette de gel (`freeze/v1.2.0`), null sans gel.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "livrees": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ids des fiches livrées du lot."
              },
              "aFaire": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ids des fiches restant à livrer, hors parkées."
              },
              "pretes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Parmi aFaire : les fiches prêtes."
              },
              "bloquees": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Parmi aFaire : les fiches bloquées."
              },
              "intrus": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Fiches parkées qui portent pourtant cette version : hors lot."
              }
            },
            "required": [
              "version",
              "nom",
              "milestones",
              "etat",
              "cycleDeVie",
              "etiquette",
              "dateEtiquette",
              "etiquetteGel",
              "livrees",
              "aFaire",
              "pretes",
              "bloquees",
              "intrus"
            ]
          },
          "description": "Un lot par version bien écrite. Les fiches closes sans livraison n’y sont pas."
        },
        "illisibles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "version",
              "file"
            ]
          },
          "description": "Fiches dont la version est mal écrite : dans aucun lot, jamais ignorées."
        },
        "prochaineCoupe": {
          "type": "object",
          "properties": {
            "derniereEtiquette": {
              "description": "La plus haute étiquette `vX.Y.Z` ; null sans étiquette (non publié, jamais une valeur inventée).",
              "type": [
                "string",
                "null"
              ]
            },
            "livrees": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "titre": {
                    "type": "string"
                  },
                  "objectif": {
                    "type": "string",
                    "description": "'' sans objectif."
                  }
                },
                "required": [
                  "id",
                  "titre",
                  "objectif"
                ]
              },
              "description": "Fiches ajoutées à `features/done/` depuis la dernière étiquette, triées par id ; [] sans étiquette."
            },
            "nombre": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ],
              "description": "Le nombre de ces fiches ; null sans étiquette (non publié, jamais 0)."
            },
            "gate": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "GO",
                        "NO-GO"
                      ]
                    },
                    "date": {
                      "type": "string",
                      "description": "Quand le verdict a été établi (ISO 8601)."
                    },
                    "passes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "go": {
                            "type": "boolean"
                          },
                          "sautee": {
                            "type": "boolean",
                            "description": "La passe n’a pas tourné : ni GO ni NO-GO."
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "go",
                          "sautee"
                        ]
                      }
                    }
                  },
                  "required": [
                    "version",
                    "verdict",
                    "date",
                    "passes"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Le dernier verdict écrit par `ezk release` (`.vectorz/release/<version>.json`) ; null si aucun."
            },
            "carnet": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "app": {
                      "type": "string"
                    },
                    "tested": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "jamais": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "valide": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "echec": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "expire": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "app",
                    "tested",
                    "total",
                    "jamais",
                    "valide",
                    "echec",
                    "expire"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Les comptes de `ezk carto status --json` ; null sans carnet déclaré (une seule app)."
            },
            "numeroPropose": {
              "type": "null",
              "description": "Le numéro proposé pour la coupe : null tant que la règle n’est pas tranchée."
            }
          },
          "required": [
            "derniereEtiquette",
            "livrees",
            "nombre",
            "gate",
            "carnet",
            "numeroPropose"
          ],
          "description": "Ce qui attend la prochaine coupe : tout ce qui a été livré depuis la dernière étiquette (fiche 20261114131612759)."
        }
      },
      "required": [
        "courante",
        "ecartees",
        "lots",
        "illisibles",
        "prochaineCoupe"
      ]
    },
    "verdicts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "date": {
            "type": "string"
          }
        },
        "required": [
          "verdict",
          "date"
        ]
      },
      "description": "Pouces de revue posés, par id de fiche (ADR-0057)."
    },
    "historique": {
      "type": "object",
      "properties": {
        "sprints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Comptes rendus de sprint (`docs/sprints/AAAA-MM-JJ-sprint-<slug>.md`)."
        },
        "retros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Captures de rétro (`AAAA-MM-JJ-retro-<slug>.md`, dossier `scrum:` du projet)."
        }
      },
      "required": [
        "sprints",
        "retros"
      ],
      "description": "Ce que la méthode a mené dans le projet. Zéro = rien trouvé, compté (fiche 20261102104443762)."
    },
    "derniersSprints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "fichier": {
            "type": "string",
            "description": "Le compte rendu, relatif à la racine du projet."
          },
          "jour": {
            "type": "string",
            "description": "Le jour du compte rendu (`AAAA-MM-JJ`), tiré de son nom."
          },
          "fin": {
            "description": "Fin de la fenêtre du sprint (ISO 8601) ; `null` si non datée.",
            "type": [
              "string",
              "null"
            ]
          },
          "dureeMs": {
            "description": "Durée du sprint ; `null` si non mesurée (jamais un faux zéro).",
            "type": [
              "number",
              "null"
            ]
          },
          "tokens": {
            "description": "Jetons du sprint, au grain `sprint` seulement ; `null` sinon (le grain session compte tout le run).",
            "type": [
              "number",
              "null"
            ]
          },
          "livrees": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title"
              ]
            },
            "description": "Les fiches livrées du lot scellé."
          },
          "blocages": {
            "description": "Blocages essuyés ; `null` si le compte rendu ne le dit pas.",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "slug",
          "fichier",
          "jour",
          "fin",
          "dureeMs",
          "tokens",
          "livrees",
          "blocages"
        ]
      },
      "description": "Les 5 derniers comptes rendus de sprint, le plus récent d’abord (fiche 20261104090517904)."
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "`AAAA-MM-JJ`, lue du nom du récit."
          },
          "title": {
            "type": "string",
            "description": "Le premier titre du récit, ou son nom à défaut."
          },
          "file": {
            "type": "string",
            "description": "Le récit, relatif à la racine du projet."
          },
          "fiches": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fiches travaillées (ligne `fiches:` du récit)."
          },
          "prs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Numéros de PR cités dans le récit."
          }
        },
        "required": [
          "date",
          "title",
          "file",
          "fiches",
          "prs"
        ]
      },
      "description": "Sessions closes, une par récit du dossier `scrum:` du projet, la plus récente d’abord (fiche 20261102123552182)."
    },
    "verdictsIllisibles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fichiers de verdict illisibles, jamais ignorés en silence."
    }
  },
  "required": [
    "schema_version",
    "counts",
    "tirables",
    "actives",
    "milestones",
    "filtres",
    "comptes",
    "versions",
    "verdicts",
    "historique",
    "derniersSprints",
    "sessions",
    "verdictsIllisibles"
  ]
}
