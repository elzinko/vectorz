            "properties": {
              "from": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "rule",
                      "agent",
                      "skill",
                      "bundle",
                      "profile",
                      "tool",
                      "command",
                      "recipe"
                    ]
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
