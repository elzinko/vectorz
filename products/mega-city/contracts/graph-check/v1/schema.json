                ]
              },
              "to": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "rule",
                      "agent",
                      "skill",
                      "bundle",
                      "profile",
                      "tool",
                      "command",
                      "recipe"
                    ]
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ]
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "href": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "file",
              "line",
              "href"
            ]
          }
        }
      },
      "required": [
        "undeclared",
        "unsupported"
      ]
    }
