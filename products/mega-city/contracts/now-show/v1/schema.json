{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "alertes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "fiche-bloquee",
              "idee-a-groomer",
              "proposition-retro",
              "question-session",
              "version-a-poser",
              "sprint-sans-retro"
            ]
          },
          "id": {
            "type": "string",
            "description": "Identifiant de l’élément : id de fiche, version, ou `<capture>#<rang>` pour une proposition de rétro."
          },
          "titre": {
            "type": "string"
          },
          "raison": {
            "type": "string",
            "description": "Pourquoi l’élément alerte : le mot de `blocked:`, le genre de la proposition, l’état du lot."
          },
          "decision": {
            "type": "string",
            "description": "La décision attendue du PO, en français."
          },
          "fichier": {
            "type": "string",
            "description": "Le fichier source, relatif à la racine du projet ; '' si la source n'est pas un fichier."
          },
          "date": {
            "type": "string",
            "description": "Date de l'élément (`AAAA-MM-JJ`) ; '' si la méthode ne la connaît pas."
          }
        },
        "required": [
          "type",
          "id",
          "titre",
          "raison",
          "decision",
          "fichier",
          "date"
        ]
      },
      "description": "Une alerte par élément, jamais de regroupement."
    },
    "non_mesure": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ce que la méthode ne calcule pas encore, en mots. Un type listé ici n’a aucune alerte, ce n’est pas un zéro."
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "suite",
              "piste"
            ]
          },
          "command": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "command",
          "reason"
        ]
      },
      "description": "Les suites de la boussole, comme la sortie texte de `ezk now`."
    }
  },
  "required": [
    "schema_version",
    "alertes",
    "non_mesure",
    "suites"
  ]
}
