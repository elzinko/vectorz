{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "fiches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Le statut écrit. « En cours » est le drapeau enCours, jamais un statut."
          },
          "milestone": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "Version ciblée telle qu'écrite, '' sans version."
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked": {
            "type": "string",
            "description": "Raison du blocage (`blocked:`), '' si la fiche n'est pas bloquée."
          },
          "blockedLibelle": {
            "type": "string",
            "description": "La raison du blocage en français : la décision attendue, même table que `ezk now --json` ; '' sans blocage."
          },
          "pr": {
            "type": "string"
          },
          "enCours": {
            "type": "boolean",
            "description": "Une branche de travail est ouverte pour la fiche (ADR-0077)."
          },
          "done": {
            "type": "boolean",
            "description": "La fiche est rangée dans `features/done/`."
          },
          "parkee": {
            "type": "boolean",
            "description": "Idée rangée dans la milestone `parked` : hors flux, en attente du PO (règle `isParked`)."
          },
          "file": {
            "type": "string",
            "description": "Chemin de la fiche, relatif à la racine du projet."
          },
          "enClair": {
            "type": "string",
            "description": "Section « En clair », ou paragraphe `**En clair.**` ; vide si absent."
          },
          "contexte": {
            "type": "string",
            "description": "Section dont le titre commence par « Contexte » ; vide si absente."
          },
          "criteres": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "texte": {
                  "type": "string",
                  "description": "Le texte du critère, lignes de suite comprises."
                },
                "coche": {
                  "type": "boolean",
                  "description": "La case est cochée (`- [x]`)."
                }
              },
              "required": [
                "texte",
                "coche"
              ]
            },
            "description": "Cases à cocher de la section « Critères… », dans l’ordre."
          },
          "commentVerifier": {
            "type": "string",
            "description": "Section « Comment vérifier », blocs de code compris ; vide si absente."
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "priority",
          "status",
          "milestone",
          "product",
          "version",
          "labels",
          "blocked",
          "blockedLibelle",
          "pr",
          "enCours",
          "done",
          "parkee",
          "file",
          "enClair",
          "contexte",
          "criteres",
          "commentVerifier"
        ]
      },
      "description": "Les fiches de features/, hors done/, triées par id."
    },
    "livrees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "Version de la livraison telle qu'écrite, '' sans version."
          },
          "pr": {
            "type": "string"
          },
          "milestone": {
            "type": "string",
            "description": "L'objectif de la fiche, '' sans objectif."
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sprint": {
            "description": "Slug du compte rendu de sprint (`docs/sprints/`) dont le lot scellé cite la fiche, le plus récent si plusieurs ; null si aucun.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "priority",
          "version",
          "pr",
          "milestone",
          "labels",
          "sprint"
        ]
      },
      "description": "Les fiches livrées (rangées dans done/, statut shipped), en résumé, triées par id."
    }
  },
  "required": [
    "schema_version",
    "fiches",
    "livrees"
  ]
}
