{
  "name": "vectorz",
  "version": "0.1.0",
  "description": "Vectorz umbrella — Moniteur (cop1) + méthode mega-city (ezk-*)",
  "private": true,
  "type": "module",
  "author": "elzinko",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b products/cop1/packages/shared-kernel products/cop1/packages/observability products/cop1/packages/quality-intelligence products/cop1/packages/sprint-core products/cop1/packages/llm-intelligence products/cop1/packages/ceremony-engine products/cop1/packages/journal-validator products/cop1/packages/app",
    "typecheck": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
